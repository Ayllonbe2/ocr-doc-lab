                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Tipos V1 Documentos Tipos Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/documentos/clasificar": {
      "post": {
        "summary": "Clasificar",
        "description": "Qué tipo de documento parece (o `null` si ninguno), con los candidatos y su puntuación.",
        "operationId": "clasificar_v1_documentos_clasificar_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_clasificar_v1_documentos_clasificar_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Clasificar V1 Documentos Clasificar Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/documentos/{tipo}/extraer": {
      "post": {
        "summary": "Extraer",
        "description": "Lee el documento y devuelve sus campos, validaciones, autenticidad y calidad.\n\n`lectura`: COMPLETA · INCOMPLETA (revisión manual) · ILEGIBLE (pedir otra foto o escaneo) ·\nOTRO_DOCUMENTO (se ha subido otro tipo de documento). Quien llama compara los campos con sus\ndatos y decide.",
        "operationId": "extraer_v1_documentos__tipo__extraer_post",
        "parameters": [
          {
            "name": "tipo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Tipo"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_extraer_v1_documentos__tipo__extraer_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Extraer V1 Documentos  Tipo  Extraer Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
