      "Body_verificar_dni_v1_dni_verificar_post": {
        "properties": {
          "anverso": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Anverso",
            "description": "Foto del anverso del DNI (JPG, PNG, WEBP)"
          },
          "reverso": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Reverso",
            "description": "Foto del reverso del DNI, con la MRZ"
          },
          "dni_declarado": {
            "type": "string",
            "title": "Dni Declarado",
            "description": "Nº de DNI que ha indicado el usuario"
          },
          "intento": {
            "type": "integer",
            "title": "Intento",
            "description": "1 o 2: lo lleva el backend",
            "default": 1
          }
        },
        "type": "object",
        "required": [
          "anverso",
          "reverso",
          "dni_declarado"
        ],
        "title": "Body_verificar_dni_v1_dni_verificar_post"
      },
