    "/v1/dni/verificar": {
      "post": {
        "summary": "Verificar Dni",
        "description": "Verifica el DNI y devuelve VERIFICADO, REPETIR o REVISION_ADMIN.\n\nSin estado: el backend guarda el nº de intento y, en REVISION_ADMIN, avisa al admin con los\ndatos leídos y el motivo. Las imágenes se procesan en memoria y se descartan.",
        "operationId": "verificar_dni_v1_dni_verificar_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_verificar_dni_v1_dni_verificar_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Verificar Dni V1 Dni Verificar Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/documentos/tipos": {
      "get": {
        "summary": "Tipos",
        "description": "Tipos admitidos, con sus campos y cuáles son obligatorios.",
        "operationId": "tipos_v1_documentos_tipos_get",
        "responses": {
          "200": {
            "description": "Successful Response",
